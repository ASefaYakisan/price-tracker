# Local scraper settings. Copy to .env; see README Configuration.
# Load explicitly: cd scraper && node --env-file=../.env src/index.js all 3
# Required for database storage; otherwise the collector writes local JSON.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional request identity and CoinGecko demo access.
# SCRAPER_USER_AGENT=
# COINGECKO_API_KEY=

# Optional email delivery and dashboard links.
# RESEND_API_KEY=
# ALERT_FROM=
# SITE_URL=

# Optional Telegram digest. Leave TELEGRAM_MIN_DROP unset to use 2%.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_DROP=

# Optional Google Sheets sync (single-line JSON, quoted for dotenv).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_ID=

# Optional paid scraping fallback. Defaults: 900 credits/month, country tr.
# SCRAPER_API_KEY=
# UNBLOCK_HOSTS=
# UNBLOCK_MONTHLY_LIMIT=
# UNBLOCK_COUNTRY=
# UNBLOCK_RENDER_HOSTS=
# UNBLOCK_PREMIUM_HOSTS=

# Optional probe switch: set to 0 to disable paid requests.
# PROBE_API=
# GITHUB_STEP_SUMMARY is supplied by GitHub Actions; do not set locally.
# Dashboard settings belong in web/.env.local (see web/.env.example).
