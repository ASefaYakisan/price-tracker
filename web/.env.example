# Copy to .env.local; see README Configuration.
# Public values: leave empty for demo data, or set both for live data/accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database credential. Never commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public Cloudflare Turnstile site key; omitted hides the widget.
# Configure its matching secret in Supabase Auth CAPTCHA settings.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: lets a newly saved "pending" link start the GitHub Actions reader at once instead of waiting
# for the 15-minute schedule. A fine-grained token limited to this repo with Actions: read and write.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_DISPATCH_REPO=owner/repo

# Optional: comma-separated emails allowed to open /api/admin/stats (aggregate usage counts, migration 0011).
# ADMIN_EMAILS=you@example.com
