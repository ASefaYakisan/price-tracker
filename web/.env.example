# Public values (safe to commit; also in .env.production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only secret: lets /api/track save links pasted on the dashboard.
# Set it in Vercel > Settings > Environments > Production, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
