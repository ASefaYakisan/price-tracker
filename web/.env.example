# Copy to .env.local; see README Configuration.
# Public values: leave empty for demo data, or set both for live data/accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database credential. Never commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public Cloudflare Turnstile site key; omitted hides the widget.
# Configure its matching secret in Supabase Auth CAPTCHA settings.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
